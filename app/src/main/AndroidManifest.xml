<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required by the Nothing Glyph SDK (documented in the official developer kit). -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Precaution for package-visibility rules when the SDK binds Nothing's Glyph service.
         Not mentioned in Nothing's docs; harmless if unnecessary. -->
    <queries>
        <package android:name="com.nothing.thirdparty" />
    </queries>

    <application
        android:name=".GlyphApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher_ring"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphController">

        <!-- No LAUNCHER filter here: the launcher entry comes from exactly one of the aliases below. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.GlyphController" />

        <!-- Logo styles. IconStyle.applyLauncher() enables one and disables the other two. -->
        <activity-alias
            android:name=".LauncherRing"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_ring"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherG"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_g"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".LauncherBolt"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_bolt"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Opened by tapping the home-screen widget: translucent quick-setup sheet. -->
        <activity
            android:name=".QuickMenuActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:label="@string/quick_label"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@style/Theme.GlyphController.Sheet" />

        <receiver
            android:name=".GlyphWidgetProvider"
            android:exported="true"
            android:label="@string/widget_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/glyph_widget_info" />
        </receiver>

        <!-- Background engine: monitors volume / charging / screen and drives the matrix
             through setAppMatrixFrame(). -->
        <service
            android:name=".GlyphService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Drives the Nothing Glyph Matrix from volume, charging and idle state" />
        </service>

        <!-- Always-on Glyph Toy. On Phone (4a) Pro this is the only toy type the system supports.
             Selected by the user in Settings > Glyph Interface > Flip to Glyph > Always-on Glyph Toy. -->
        <service
            android:name=".GlyphToyService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/img_toy_preview" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!-- Optional: only used for the "notification" state. User must grant Notification access. -->
        <service
            android:name=".GlyphNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
